digraph G {
    rankdir=LR;
    node [fontsize=11];
    edge [fontsize=10, arrowhead=normal];
    Q [label="Query", shape=box];
    L1 [label="Layer 1: Web Server", shape=box];
    Q -> L1;
    L2 [label="Layer 2: Organic Results", shape=box];
    Q -> L2;
    L3 [label="Layer 3: Ads Server", shape=box];
    Q -> L3;
