digraph G {
    rankdir=TB;
    node [fontsize=11, shape=box, style=rounded];
    edge [fontsize=10, arrowhead=normal];

    User [label="User signals\nwatch history, search,\ndemographics", shape=ellipse];

    subgraph cluster_longform {
        label="Long-form feeds (Home, Suggested, Search, Subscriptions)";
        style=dashed;

        CandGen [label="Candidate generation\nextreme multiclass\nmillions -> hundreds"];
        Ranking [label="Ranking\nexpected watch time\n+ example age\n+ satisfaction (2025)"];
        LongFeed [label="Ranked feed", style="rounded,filled", fillcolor=lightgrey];

        CandGen -> Ranking -> LongFeed;
    }

    subgraph cluster_shorts {
        label="Shorts feed (separate system)";
        style=dashed;

        Seed [label="Explore phase\nshow to seed audience"];
        Signals [label="Observe signals\nswipe/skip rate, replays/loops,\nlikes, comments, shares"];
        Decision [label="Promote further?", shape=diamond];
        Wider [label="Exploit phase\nexpand distribution\n(week over week)"];
        Halt [label="Halt promotion"];
        ShortsFeed [label="Ranked Shorts feed", style="rounded,filled", fillcolor=lightgrey];

        Seed -> Signals -> Decision;
        Decision -> Wider [label="positive"];
        Decision -> Halt [label="negative"];
        Wider -> ShortsFeed;
        Wider -> Signals [label="next round", style=dashed, constraint=false];
    }

    User -> CandGen;
    User -> Seed [label="seed audience\nselection"];
}
