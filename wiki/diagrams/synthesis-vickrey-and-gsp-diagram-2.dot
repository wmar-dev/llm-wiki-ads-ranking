digraph G {
    rankdir=LR;
    node [fontsize=11];
    edge [fontsize=10, arrowhead=normal];
    B [label="Bids submitted", shape=box];
    R [label="Rank by bid × quality score", shape=box];
    B -> R;
    S1 [label="Slot 1 → pays min to beat Slot 2", shape=box];
    R -> S1;
    S2 [label="Slot 2 → pays min to beat Slot 3", shape=box];
    R -> S2;
    S3 [label="Slot 3 → pays min to beat next or reserve", shape=box];
    R -> S3;
}